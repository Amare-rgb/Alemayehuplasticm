// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum ProductStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProductVisibility {
  VISIBLE
  HIDDEN
}

enum OrderStatus {
  PENDING
  SHIPPED
  COMPLETED
  CANCELLED
  REJECTED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum CategoryStatus {
  PENDING
  APPROVED
  REJECTED
  INACTIVE
  HIDDEN
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(USER)
  avatar    String?
  phone     String?
  address   String?
  bio       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  adminProfile       AdminProfile?
  profile            Profile?
  orders             Order[]
  cartItems          CartItem[]
  reviews            Review[]
  addresses          Address[]
  blogPosts          BlogPost[]
  categories         Category[]      @relation("CategoryCreator")
  approvedCategories Category[]      @relation("CategoryApprover")
  articles           Article[]       @relation("ArticleAuthor")
  chatMessages       ChatMessage[]

  @@index([role])
  @@index([createdAt])
  @@map("users")
}

// ============================================
// CHAT MESSAGE MODEL
// ============================================
model ChatMessage {
  id             String   @id @default(cuid())
  userId         String
  conversationId String
  userMessage    String   @db.Text
  botResponse    String   @db.Text
  timestamp      DateTime @default(now())

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([conversationId])
  @@index([timestamp])
  @@map("chat_messages")
}

// ============================================
// UNIFIED PROFILE MODEL
// ============================================
model Profile {
  id          String   @id @default(cuid())
  userId      String   @unique
  shopName    String?
  shopDesc    String?
  logo        String?
  phone       String?
  isVerified  Boolean  @default(false)
  totalSales  Int      @default(0)
  address     String?
  banner      String?

  // Admin-specific fields
  isAdmin     Boolean  @default(false)
  adminRole   String?
  permissions String[]
  lastLogin   DateTime?
  status      String   @default("active")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model AdminProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  permissions String[]
  department  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admin_profiles")
}

model Category {
  id              String         @id @default(cuid())
  name            String         @unique
  slug            String         @unique
  description     String?
  image           String?
  icon            String?
  color           String?
  parentId        String?
  status          CategoryStatus @default(PENDING)
  createdBy       String?
  approvedBy      String?
  approvedAt      DateTime?
  rejectedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  creator     User?      @relation("CategoryCreator", fields: [createdBy], references: [id])
  approver    User?      @relation("CategoryApprover", fields: [approvedBy], references: [id])
  products    Product[]
  subProducts Product[]  @relation("ProductSubCategory")

  @@map("categories")
}

model Product {
  id                String            @id @default(cuid())
  name              String
  slug              String            @unique
  description       String            @db.Text
  price             Decimal           @db.Decimal(10, 2)
  discountPrice     Decimal?          @db.Decimal(10, 2)
  stock             Int               @default(0)
  sku               String            @unique
  images            String[]
  status            ProductStatus     @default(PENDING)
  visibility        ProductVisibility @default(VISIBLE)
  adminNote         String?
  categoryId        String
  subCategoryId     String?
  tags              String[]
  warranty          String?
  videoUrl          String?
  unitOfMeasurement String            @default("pcs")
  sizes             String?
  colors            String?
  brand             String?
  weight            Float?
  estimatedDelivery String?
  rejectionReason   String?
  durationTime      String?           @default("1h")
  pricePerUnit      Decimal?          @db.Decimal(10, 2)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  category    Category   @relation(fields: [categoryId], references: [id])
  subCategory Category?  @relation("ProductSubCategory", fields: [subCategoryId], references: [id])
  cartItems   CartItem[]
  orderItems  OrderItem[]
  reviews     Review[]

  @@index([categoryId])
  @@index([status])
  @@index([visibility])
  @@index([sku])
  @@map("products")
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  items     CartItem[]

  @@map("carts")
}

model CartItem {
  id        String @id @default(cuid())
  userId    String
  cartId    String
  productId String
  quantity  Int    @default(1)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("cart_items")
}

// ============================================
// ORDER MODEL
// ✅ `id`               = cuid (Primary Key)
// ✅ `orderNumber`      = Unique Sequential Int
// ✅ `paymentMethod`    = canonical string ("Cash on Delivery" | "Bank Transfer" | "Telebirr")
// ✅ `(paymentMethod, paymentRef)` = composite UNIQUE — one ref per method
// ============================================
model Order {
  id              String        @id @default(cuid())
  orderNumber     Int           @unique @default(autoincrement())

  userId          String
  total           Decimal       @db.Decimal(10, 2)
  status          OrderStatus   @default(PENDING)
  paymentStatus   PaymentStatus @default(PENDING)
  addressId       String

  // Payment info persisted from checkout
  paymentMethod   String?
  paymentRef      String?
  paymentProof    String?       @db.Text

  stripeSessionId String?
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user    User        @relation(fields: [userId], references: [id])
  address Address     @relation(fields: [addressId], references: [id])
  items   OrderItem[]

  // ✅ Composite unique: same ref cannot exist twice for the SAME method.
  //    Multiple rows with NULL ref are allowed (COD, pending Telebirr).
  @@unique([paymentMethod, paymentRef], name: "uniq_payment_ref_per_method")

  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
  @@index([paymentMethod])
  @@index([paymentRef])
  @@index([orderNumber])
  @@index([createdAt])
  @@map("orders")
}

// ============================================
// ORDER ITEM MODEL
// ============================================
model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  price     Decimal @db.Decimal(10, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  productId String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([userId, productId])
  @@map("reviews")
}

model Address {
  id        String  @id @default(cuid())
  userId    String
  fullName  String
  phone     String
  street    String
  city      String
  state     String
  zip       String
  country   String  @default("Ethiopia")
  isDefault Boolean @default(false)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId])
  @@map("addresses")
}

model BlogPost {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  content   String   @db.Text
  excerpt   String?
  image     String?
  video     String?
  category  String   @default("Agriculture")
  readTime  Int      @default(3)
  published Boolean  @default(true)
  views     Int      @default(0)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorId])
  @@map("blog_posts")
}

model Article {
  id            String        @id @default(cuid())
  title         String
  author        String
  summary       String?
  content       String        @db.Text
  note          String?       @db.Text

  pdfUrl        String?
  pdfFileName   String?
  pdfFileSize   Int?

  status        ArticleStatus @default(PUBLISHED)
  views         Int           @default(0)
  downloads     Int           @default(0)
  tags          String[]
  createdBy     String?
  publishedAt   DateTime      @default(now())
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  authorUser    User?         @relation("ArticleAuthor", fields: [createdBy], references: [id])

  @@index([status, createdAt])
  @@index([author])
  @@index([createdBy])
  @@map("articles")
}

model Settings {
  id                   String   @id @default(cuid())
  siteName             String   @default("Genesis Agri Business")
  siteDescription      String?  @default("Agriculture marketplace connecting farmers and buyers")
  adminEmail           String   @default("admin@genesisagri.com")
  adminPhone           String?  @default("+1 (555) 123-4567")
  address              String?  @default("123 Farm Road, Nairobi, Kenya")
  timezone             String   @default("Africa/Nairobi")
  dateFormat           String   @default("MM/DD/YYYY")
  storeName            String   @default("Genesis Agri Business")
  storeEmail           String   @default("info@genesisagri.com")
  storePhone           String?  @default("+1 (555) 123-4567")
  storeAddress         String?  @default("123 Farm Road, Nairobi, Kenya")
  currency             String   @default("ETB")
  taxRate              Float    @default(16)
  logo                 String?  @default("")
  favicon              String?  @default("")
  twoFactorAuth        Boolean  @default(false)
  sessionTimeout       Int      @default(60)
  emailNotifications   Boolean  @default(true)
  orderNotifications   Boolean  @default(true)
  productNotifications Boolean  @default(true)
  userNotifications    Boolean  @default(true)
  marketingEmails      Boolean  @default(false)
  themeColor           String   @default("#22c55e")
  darkMode             Boolean  @default(false)

  contactEmail         String?  @default("support@genesisagri.com")
  contactPhone         String?  @default("+1 (555) 123-4567")
  contactAddress       String?  @default("123 Agriculture Way, Farming District, FC 12345")
  contactHours         String?  @default("Mon-Fri: 8:00 AM - 6:00 PM")
  contactMapEmbed      String?  @default("")
  enableContactForm    Boolean  @default(true)
  enableWhatsApp       Boolean  @default(true)
  whatsAppNumber       String?  @default("+254700000000")
  enableLiveChat       Boolean  @default(false)
  emergencyPhone       String?  @default("+1 (555) 999-9999")
  supportEmail         String?  @default("support@genesisagri.com")
  infoEmail            String?  @default("info@genesisagri.com")

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("settings")
}