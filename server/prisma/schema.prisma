// prisma/schema.prisma
generator client {
  provider      = "prisma-client-js"
  // "native" = your computer, "rhel-openssl-3.0.x" = Netlify Functions / Vercel / AWS Lambda
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  // Pooled Neon URL (host contains "-pooler"), used by the app at runtime
  url       = env("DATABASE_URL")
  // Direct Neon URL (host WITHOUT "-pooler"), used by prisma migrate
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(USER)
  avatar    String?
  phone     String?
  address   String?
  bio       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  adminProfile       AdminProfile?
  profile            Profile?
  orders             Order[]
  cartItems          CartItem[]
  reviews            Review[]
  addresses          Address[]
  categories         Category[]    @relation("CategoryCreator")
  articles           Article[]     @relation("ArticleAuthor")
  chatMessages       ChatMessage[]

  @@index([role])
  @@index([createdAt])
  @@map("users")
}

// ============================================
// CHAT MESSAGE MODEL
// ============================================
model ChatMessage {
  id             String   @id @default(cuid())
  userId         String
  conversationId String
  userMessage    String   @db.Text
  botResponse    String   @db.Text
  timestamp      DateTime @default(now())

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([conversationId])
  @@index([timestamp])
  @@map("chat_messages")
}

// ============================================
// UNIFIED PROFILE MODEL
// ============================================
model Profile {
  id          String    @id @default(cuid())
  userId      String    @unique
  shopName    String?
  shopDesc    String?
  logo        String?
  phone       String?
  isVerified  Boolean   @default(false)
  totalSales  Int       @default(0)
  address     String?
  banner      String?

  // Admin-specific fields
  isAdmin     Boolean   @default(false)
  adminRole   String?
  permissions String[]
  lastLogin   DateTime?
  status      String    @default("active")

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model AdminProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  permissions String[]
  department  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admin_profiles")
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  image       String?
  icon        String?
  color       String?
  parentId    String?
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  creator     User?      @relation("CategoryCreator", fields: [createdBy], references: [id])
  products    Product[]
  subProducts Product[]  @relation("ProductSubCategory")

  @@map("categories")
}

model Product {
  id                String   @id @default(cuid())
  name              String
  slug              String   @unique
  description       String   @db.Text
  price             Decimal  @db.Decimal(10, 2)
  discountPrice     Decimal? @db.Decimal(10, 2)
  stock             Int      @default(0)
  sku               String   @unique
  images            String[]
  categoryId        String
  subCategoryId     String?
  tags              String[]
  warranty          String?
  videoUrl          String?
  unitOfMeasurement String   @default("pcs")
  sizes             String?
  colors            String?
  brand             String?
  weight            Float?
  estimatedDelivery String?
  durationTime      String?  @default("1h")
  pricePerUnit      Decimal? @db.Decimal(10, 2)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  category    Category    @relation(fields: [categoryId], references: [id])
  subCategory Category?   @relation("ProductSubCategory", fields: [subCategoryId], references: [id])
  cartItems   CartItem[]
  orderItems  OrderItem[]
  reviews     Review[]

  @@index([categoryId])
  @@index([sku])
  @@map("products")
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  items     CartItem[]

  @@map("carts")
}

model CartItem {
  id        String @id @default(cuid())
  userId    String
  cartId    String
  productId String
  quantity  Int    @default(1)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("cart_items")
}

// ============================================
// ORDER MODEL — payment tracking removed
// ============================================
model Order {
  id          String   @id @default(cuid())
  orderNumber Int      @unique @default(autoincrement())

  userId      String
  total       Decimal  @db.Decimal(10, 2)
  addressId   String

  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user    User        @relation(fields: [userId], references: [id])
  address Address     @relation(fields: [addressId], references: [id])
  items   OrderItem[]

  @@index([userId])
  @@index([orderNumber])
  @@index([createdAt])
  @@map("orders")
}

// ============================================
// ORDER ITEM MODEL
// ============================================
model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  price     Decimal @db.Decimal(10, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  productId String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([userId, productId])
  @@map("reviews")
}

model Address {
  id        String  @id @default(cuid())
  userId    String
  fullName  String
  phone     String
  street    String
  city      String
  state     String
  zip       String
  country   String  @default("Ethiopia")
  isDefault Boolean @default(false)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId])
  @@map("addresses")
}

// ============================================
// ARTICLE MODEL — status approval removed
// ============================================
model Article {
  id           String   @id @default(cuid())
  title        String
  author       String
  summary      String?
  content      String   @db.Text
  note         String?  @db.Text

  pdfUrl       String?
  pdfFileName  String?
  pdfFileSize  Int?

  views        Int      @default(0)
  downloads    Int      @default(0)
  tags         String[]
  createdBy    String?
  publishedAt  DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  authorUser   User?    @relation("ArticleAuthor", fields: [createdBy], references: [id])

  @@index([author])
  @@index([createdBy])
  @@map("articles")
}

// ============================================
// SETTINGS MODEL — rebranded for Alemayehu Plastic
// ============================================
model Settings {
  id                   String   @id @default(cuid())
  siteName             String   @default("Alemayehu Plastic Manufacturing")
  siteDescription      String?  @default("Quality plastic products manufactured in Ethiopia")
  adminEmail           String   @default("admin@alemayehplastic.com")
  adminPhone           String?  @default("+251 900 000 000")
  address              String?  @default("Bahir Dar, Ethiopia")
  timezone             String   @default("Africa/Addis_Ababa")
  dateFormat           String   @default("MM/DD/YYYY")
  storeName            String   @default("Alemayehu Plastic Manufacturing")
  storeEmail           String   @default("info@alemayehplastic.com")
  storePhone           String?  @default("+251 900 000 000")
  storeAddress         String?  @default("Bahir Dar, Ethiopia")
  currency             String   @default("ETB")
  taxRate              Float    @default(15)
  logo                 String?  @default("")
  favicon              String?  @default("")
  twoFactorAuth        Boolean  @default(false)
  sessionTimeout       Int      @default(60)
  emailNotifications   Boolean  @default(true)
  orderNotifications   Boolean  @default(true)
  productNotifications Boolean  @default(true)
  userNotifications    Boolean  @default(true)
  marketingEmails      Boolean  @default(false)
  themeColor           String   @default("#e0a83c")
  darkMode             Boolean  @default(false)

  contactEmail         String?  @default("support@alemayehplastic.com")
  contactPhone         String?  @default("+251 900 000 000")
  contactAddress       String?  @default("Bahir Dar, Ethiopia")
  contactHours         String?  @default("Mon-Sat: 8:00 AM - 6:00 PM")
  contactMapEmbed      String?  @default("")
  enableContactForm    Boolean  @default(true)
  enableWhatsApp       Boolean  @default(true)
  whatsAppNumber       String?  @default("+251900000000")
  enableLiveChat       Boolean  @default(false)
  emergencyPhone       String?  @default("+251 900 000 000")
  supportEmail         String?  @default("support@alemayehplastic.com")
  infoEmail            String?  @default("info@alemayehplastic.com")

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("settings")
}